generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String    @id @default(uuid())
  name      String
  taxId     String    @unique
  country   String    @default("KSA") // "KSA" or "EGY"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[]
  batches   Batch[]

  @@map("tenants")
}

model Batch {
  id             String    @id @default(uuid())
  tenantId       String?
  tenant         Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String    @default("Batch Audit")
  status         String    @default("QUEUED") // "QUEUED", "PROCESSING", "COMPLETED", "FAILED"
  totalInvoices  Int       @default(0)
  processedCount Int       @default(0)
  compliantCount Int       @default(0)
  flaggedCount   Int       @default(0)
  progress       Float     @default(0.0)
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  invoices       Invoice[]

  @@index([tenantId])
  @@map("batches")
}

model Invoice {
  id            String         @id @default(uuid())
  tenantId      String?
  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batchId       String?
  batch         Batch?         @relation(fields: [batchId], references: [id], onDelete: SetNull)
  invoiceNumber String
  issueDate     DateTime
  country       String         // "KSA" or "EGY"
  supplierName  String
  supplierTaxId String
  subtotal      Float
  totalVat      Float
  totalAmount   Float
  currency      String         @default("SAR") // "SAR" or "EGP"
  status        String         @default("COMPLIANT") // "COMPLIANT", "FLAGGED"
  hasErrors     Boolean        @default(false)
  lineItems     LineItem[]
  findings      AuditFinding[]
  aiLogs        AiCostLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId])
  @@index([batchId])
  @@index([invoiceNumber])
  @@map("invoices")
}

model LineItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float
  unitPrice   Float
  subtotal    Float
  vatRate     Float
  vatAmount   Float
  total       Float

  @@map("line_items")
}

model AuditFinding {
  id            String   @id @default(uuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  ruleCode      String   // e.g. "ARITHMETIC_MISMATCH", "INVALID_TAX_ID", "EXPENSE_ANOMALY"
  layer         String   @default("RULE_ENGINE") // "RULE_ENGINE" or "AI_SEMANTIC"
  severity      String   // "CRITICAL", "HIGH", "MEDIUM", "LOW"
  messageEn     String
  messageAr     String
  expectedValue String?
  actualValue   String?
  createdAt     DateTime @default(now())

  @@index([invoiceId])
  @@map("audit_findings")
}

model AiCostLog {
  id           String   @id @default(uuid())
  invoiceId    String?
  invoice      Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  model        String
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  durationMs   Int
  createdAt    DateTime @default(now())

  @@index([invoiceId])
  @@map("ai_cost_logs")
}
